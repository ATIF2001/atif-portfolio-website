<script src="https://www.dubcdn.com/analytics/script.js" async></script>


<script>
  document.addEventListener("click", function (e) {
    const link = e.target.closest("a[href]");
    if (!link) return;

    if (link.href.startsWith("https://dashboard.weweb.io/sign-up")) {
      analytics.track("Sign Up Link Clicked", {
        href: link.href,
        text: link.innerText.trim(),
        location: window.location.pathname,
      });
    }
  });
</script>
